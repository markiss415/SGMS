# Frontend settings (copy to ".env" only if you need to change them).

# Development: where the Vite dev server forwards /api requests.
BACKEND_URL=http://localhost:4000

# Production build only: full URL of the deployed API, e.g. https://bangbang-sgms-api.onrender.com/api
# Leave empty to use "/api" on the same domain (for example through the Vercel rewrite in vercel.json).
VITE_API_URL=
