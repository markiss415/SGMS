# ─────────────────────────────────────────────────────────────
# Barangay Bang-Bang Smart Garbage Monitoring System — settings
# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
# Frontend address(es) allowed to call this API (comma-separated). Add your Vercel URL in production.
CORS_ORIGIN=http://localhost:5173

# MySQL 8 connection (local MySQL for development, Aiven MySQL for production).
# Use the SAME user + password you use to log in to MySQL Workbench.
# The database is created automatically if it does not exist yet.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bangbang_sgms
# Aiven: set MYSQL_SSL=true and paste the CA certificate (or a path to ca.pem) in MYSQL_SSL_CA
MYSQL_SSL=false
MYSQL_SSL_CA=

# Database used ONLY by `npm test` (it is wiped on every run — its name must contain "test")
MYSQL_DATABASE_TEST=bangbang_sgms_test

# Password for every demo account created by `npm run db:seed:demo` / `npm run db:reset`
# (at least 8 characters with letters and numbers). Development only.
SEED_PASSWORD=Barangay2026

# First admin account for a real (non-demo) installation: `npm run db:seed`
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Barangay Administrator

# How long a sign-in lasts (hours)
SESSION_TTL_HOURS=12

# Behind a proxy/load balancer (Render, Railway…) set to 1 so rate limits see the real IP
TRUST_PROXY=0

# Email (SMTP) for the registration OTP codes and password-reset codes.
# Without SMTP (development), the 6-digit codes are printed in this backend terminal instead.
# In production (NODE_ENV=production) SMTP is REQUIRED for registration.
#
# Gmail example (use a 16-letter App Password, NOT your normal Gmail password):
#   1) https://myaccount.google.com → Security → turn on 2-Step Verification
#   2) https://myaccount.google.com/apppasswords → create one (name: SGMS) → copy the 16 letters
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASSWORD=abcdefghijklmnop
#   SMTP_FROM=Barangay Bang-Bang SGMS <yourname@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Barangay Bang-Bang SGMS <no-reply@example.com>
